.imgElements {
}

.barritaVida {
    flex-grow: 0;
    width: 2%;
    height: 7%;
    align-items: auto;
    flex-shrink: 0;
    margin-top: 1%;
    margin-right: 0.5%;
    margin-bottom: 1%;
    margin-left: 0.5%;
    background-color: rgb(82, 178, 41);
}

.barraMineral {
    width: 30%;
    height: 20%;
    flex-wrap: nowrap;
    position: absolute;
    top: 10%;
}

.unity-progress-bar__progress {
    background-color: rgb(169, 43, 221);
    display: flex;
    flex-shrink: 0;
}

.unity-progress-bar__background {
    background-color: rgba(212, 187, 213, 0.73);
}

.unity-progress-bar__container {
    background-color: rgb(106, 219, 0);
}
